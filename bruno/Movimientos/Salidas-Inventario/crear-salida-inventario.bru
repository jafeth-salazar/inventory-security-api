meta {
  name: Crear salida de inventario
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/salidas-inventario
  body: json
  auth: inherit
}

body:json {
  {
    "productoId": "{{productoId}}",
    "bodegaId": "{{bodegaId}}",
    "cantidad": 5,
    "motivo": "Venta"
  }
}

script:post-response {
  bru.setVar("salidaInventarioId", res.body.id);
}
