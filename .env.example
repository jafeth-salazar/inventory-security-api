NODE_ENV=development
PORT=3000

# SQL Server
DB_HOST=db
DB_PORT=1433
DB_NAME=InventorySecurityDB
DB_USER=inventory_app
DB_PASSWORD=ChangeMe_Strong123!
MSSQL_SA_PASSWORD=ChangeMe_Strong123!

# Usado solo por el CLI de TypeORM (migraciones/seeds) — necesita permisos de
# DDL que inventory_app (perfil auditor) no tiene. inv_dba es db_owner.
DB_MIGRATION_USER=inv_dba
DB_MIGRATION_PASSWORD=ChangeMe_DBA_2026!

# JWT de sesión emitido por POST /auth/login. Nunca contiene la password ni
# el rol del usuario, solo sessionId/usuario — ver "Sesión SQL dinámica" en CLAUDE.md.
JWT_SECRET=ChangeMe_JwtSecret_2026!
JWT_EXPIRES_IN=15m
